{
  "manifest_version": 3,
  "name": "Glowverse",
  "description": "Sends YouTube Music playback to the Glowverse desktop overlay.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://music.youtube.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Glowverse",
    "default_popup": "popup.html"
  }
}
